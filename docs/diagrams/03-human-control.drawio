<mxfile host="app.diagrams.net"><diagram name="Un control humano" id="03-human-control"><mxGraphModel dx="1100" dy="520" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="520" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="k1" value="&lt;b&gt;Resumen para decidir&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;nb_ctl_summary&lt;br&gt;conteos, causales, techos&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;strokeWidth=2;fontSize=12;fillColor=#DFF3E7;strokeColor=#1A7F4B;fontColor=#12301F;" vertex="1" parent="1"><mxGeometry x="30" y="175" width="190" height="80" as="geometry"/></mxCell><mxCell id="k2" value="&lt;b&gt;Solicitud: PENDIENTE&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;ctl.approvals&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;strokeWidth=2;fontSize=12;fillColor=#E1F0F3;strokeColor=#0B6E7A;fontColor=#08323A;" vertex="1" parent="1"><mxGeometry x="270" y="175" width="170" height="80" as="geometry"/></mxCell><mxCell id="k3" value="&lt;b&gt;¿Quién decide?&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Plan A: Approval (Outlook/Teams)&lt;br&gt;Plan B: Until + nb_approve&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;strokeWidth=2;fontSize=12;fillColor=#E1F0F3;strokeColor=#0B6E7A;fontColor=#08323A;shape=rhombus;perimeter=rhombusPerimeter;" vertex="1" parent="1"><mxGeometry x="490" y="150" width="220" height="130" as="geometry"/></mxCell><mxCell id="k4" value="&lt;b&gt;APROBADO&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;nb_record_approval&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;strokeWidth=2;fontSize=12;fillColor=#DFF3E7;strokeColor=#1A7F4B;fontColor=#12301F;" vertex="1" parent="1"><mxGeometry x="760" y="40" width="160" height="70" as="geometry"/></mxCell><mxCell id="k8" value="&lt;b&gt;Sigue la etapa&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;manda la última decisión&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;strokeWidth=2;fontSize=12;fillColor=#DFF3E7;strokeColor=#1A7F4B;fontColor=#12301F;" vertex="1" parent="1"><mxGeometry x="960" y="40" width="120" height="70" as="geometry"/></mxCell><mxCell id="k6" value="&lt;b&gt;RECHAZADO o VENCIDO&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;nb_record_approval&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;strokeWidth=2;fontSize=12;fillColor=#FDE2E0;strokeColor=#C0392B;fontColor=#4A1410;" vertex="1" parent="1"><mxGeometry x="760" y="320" width="160" height="70" as="geometry"/></mxCell><mxCell id="k7" value="&lt;b&gt;Falla el pipeline&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;nada se publica&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;strokeWidth=2;fontSize=12;fillColor=#FDE2E0;strokeColor=#C0392B;fontColor=#4A1410;" vertex="1" parent="1"><mxGeometry x="960" y="320" width="120" height="70" as="geometry"/></mxCell><mxCell id="f1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#546E7A;endArrow=block;endFill=1;" edge="1" parent="1" source="k1" target="k2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#546E7A;endArrow=block;endFill=1;" edge="1" parent="1" source="k2" target="k3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f3" value="aprueba" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#546E7A;endArrow=block;endFill=1;exitX=0.5;exitY=0;entryX=0;entryY=0.5;" edge="1" parent="1" source="k3" target="k4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f4" value="rechaza o vence" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#C0392B;dashed=1;endArrow=block;endFill=1;fontSize=11;fontColor=#C0392B;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="k3" target="k6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#C0392B;dashed=1;endArrow=block;endFill=1;fontSize=11;fontColor=#C0392B;" edge="1" parent="1" source="k6" target="k7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#546E7A;endArrow=block;endFill=1;" edge="1" parent="1" source="k4" target="k8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n1" value="&lt;b&gt;Garantía en código:&lt;/b&gt; nb_07_publish se niega a publicar si C1 a C4 no están APROBADOS (vencido o ausente cuenta como rechazo, §19).&lt;br&gt;Una nueva solicitud pendiente reabre el control." style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;strokeWidth=2;fontSize=12;fillColor=#ECEFF1;strokeColor=#78909C;fontColor=#263238;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="30" y="430" width="700" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>